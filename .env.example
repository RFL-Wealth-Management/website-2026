# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# Values prefixed NEXT_PUBLIC_ are exposed to the browser — keep secrets out.
# ---------------------------------------------------------------------------

# Sanity — Phase 0
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-20

# Server-only. Viewer-scoped token used for draft mode / preview reads.
SANITY_API_READ_TOKEN=

# Server-only. Editor-scoped token used by the content pipeline — Phase 3B.
SANITY_API_WRITE_TOKEN=

# Site origin, used for canonical URLs, sitemap and short links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Later phases — listed here so deploy config is set up once.
# ---------------------------------------------------------------------------

# reCAPTCHA v3 — Phase 4
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Zoho Flow webhooks — Phase 4.
# One variable per form key. Sanity stores the KEY (e.g. "contact-general");
# the URL never leaves the server.
# ZOHO_WEBHOOK_CONTACT_GENERAL=

# Campaign links API — Phase 8B
# LINKS_API_TOKEN=
